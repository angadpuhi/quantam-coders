// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  password   String    // Hashed with bcrypt
  role       String    @default("STAFF") // "STAFF" or "ADMIN"
  facilityId String?
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Worker {
  id               String      @id @default(cuid())
  name             String
  dob              DateTime?
  gender           String
  phone            String?
  homeState        String
  currentAddress   String?
  portableHealthId String      @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  visits           Visit[]
  screenings       Screening[]
  treatments       Treatment[]
}

model Facility {
  id         String      @id @default(cuid())
  name       String
  location   String
  type       String      // e.g., PHC, CHC, General Hospital, Mobile Camp
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  users      User[]
  visits     Visit[]
  screenings Screening[]
}

model Visit {
  id         String      @id @default(cuid())
  workerId   String
  facilityId String
  date       DateTime    @default(now())
  notes      String?
  createdAt  DateTime    @default(now())

  worker     Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  facility   Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  treatments Treatment[]
}

model Screening {
  id         String   @id @default(cuid())
  workerId   String
  facilityId String
  type       String   // e.g., Tuberculosis, Hypertension, Diabetes, Malaria, Occupational Health
  result     String   // e.g., Normal, Positive, Negative, Elevated, Under Review
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model Treatment {
  id          String   @id @default(cuid())
  workerId    String
  visitId     String?
  description String
  medication  String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  visit       Visit?   @relation(fields: [visitId], references: [id], onDelete: Cascade)
}
